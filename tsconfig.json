{
  "compilerOptions": {
    "moduleDetection": "force",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "prisma.config.ts", "../e-commerce/src/store/useCartStore.tsx"],
  "exclude": ["node_modules", "src/**/*.spec.ts", "src/**/*.test.ts"]
}